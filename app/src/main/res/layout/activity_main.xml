<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RESTful Services App"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#006837"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consulta y crea publicaciones usando una API REST"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnGet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consultar publicaciones (GET)" />

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Título de la publicación"
            android:inputType="textCapSentences"
            android:minHeight="48dp"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Escribe el contenido"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnPost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enviar publicación (POST)" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:indeterminate="true"
            android:contentDescription="Cargando información" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aquí aparecerán los resultados."
            android:textSize="16sp"
            android:textColor="#1E293B"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:importantForAccessibility="yes" />

    </LinearLayout>
</ScrollView>
